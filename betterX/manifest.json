{
  "manifest_version": 3,
  "name": "betterX",
  "version": "1.0.0",
  "description": "Hide video tweets on X.com with an in-page manager.",
  "action": {
    "default_title": "betterX"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
