{
  "manifest_version": 3,
  "name": "BiliPocketReader",
  "version": "1.0",
  "description": "B\u7ad9\u6f2b\u753b\u6a21\u5f0f\u9605\u8bfb\u5668 + \u6536\u85cf\u5939\u5feb\u6377\u8df3\u8f6c",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://bilibili.com/*",
    "*://*.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://bilibili.com/*",
        "*://*.bilibili.com/*"
      ],
      "js": [
        "shared.js",
        "storage-service.js",
        "bilibili-dom-adapter.js",
        "animations.js",
        "comic-reader-images.js",
        "reader-preferences.js",
        "reader-screenshot.js",
        "reader-transform.js",
        "reader-selection.js",
        "reader-dom.js",
        "comic-reader-page-groups.js",
        "comic-reader-interactions.js",
        "comic-reader.js",
        "content-page-info.js",
        "content-url.js",
        "space-opus-tabs.js",
        "dynamic-filter.js",
        "favorites-text-dialog.js",
        "settings-popover-ui.js",
        "favorites-ui.js",
        "content.js"
      ],
      "css": [
        "content-base.css",
        "content-toolbox.css",
        "content-reader.css",
        "content-responsive.css"
      ]
    }
  ]
}
