<Window x:Class="LoopScroller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:LoopScroller.Rendering"
        xmlns:loaders="clr-namespace:LoopScroller.Loaders"
        Title="LoopScroller"
        Icon="Assets/LoopScroller.ico"
        Width="980" Height="680" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#111218"
        Foreground="#F0F0F6"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid x:Name="RootGrid">
        <Grid x:Name="StartPage">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.7" RadiusY="0.85">
                    <GradientStop Color="#252334" Offset="0"/>
                    <GradientStop Color="#111218" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="32,24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/LoopScroller.ico" Width="28" Height="28" Margin="0,0,10,0"/>
                    <TextBlock Text="LoopScroller" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="14"
                        BorderBrush="#494654" BorderThickness="1" Focusable="True"
                        ToolTipService.ShowDuration="30000" AutomationProperties.Name="快捷键帮助">
                    <Border.ToolTip>
                        <TextBlock Text="Ctrl+O　打开文件&#10;Space　 暂停 / 继续&#10;↑ / ↓　 调整速度&#10;+ / −　 调整缩放&#10;滚轮　　调整位置&#10;F11　　 切换全屏&#10;Esc　　 返回首页" LineHeight="24"/>
                    </Border.ToolTip>
                    <TextBlock Text="?" Foreground="#ABA7BC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Width="500" Padding="38,24" CornerRadius="24" Margin="24,0,24,16"
                    Background="#1C1D27" BorderBrush="#34333F" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="循环播放" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Border x:Name="DropZone" Height="206" CornerRadius="16"
                            Background="#171820" BorderBrush="#484253" BorderThickness="1" Padding="24">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="40" Height="42" Margin="0,0,0,16">
                                <Path Data="M 10,2 L 26,2 L 34,10 L 34,39 L 6,39 L 6,2 Z M 25,2 L 25,11 L 34,11 M 13,20 L 27,20 M 13,27 L 23,27"
                                      Stroke="#B8AAF3" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                            </Grid>
                            <TextBlock Text="拖入文件，即刻开始" FontSize="16" Foreground="#D1CDD9" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Button Content="选择文件" Width="164" HorizontalAlignment="Center"
                                    Background="{StaticResource AccentBrush}" Foreground="#191523" BorderBrush="{StaticResource AccentBrush}"
                                    FontWeight="SemiBold" Click="OpenFile_Click" ToolTip="打开文件 · Ctrl+O"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{x:Static loaders:ContentLoaderFactory.FormatSummary}" Foreground="#A4A0B2" FontSize="12" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock x:Name="StartStatusText" Foreground="#FCA5A5" FontSize="14"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="PlayerPage" Visibility="Collapsed" Background="#05070C">
            <Grid x:Name="ScrollViewport" ClipToBounds="True">
                <rendering:LoopSurface x:Name="Surface"/>
            </Grid>

            <Border x:Name="ControlOverlay" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20"
                    Padding="12,8" CornerRadius="18" Background="#F21C1D27"
                    BorderBrush="#494452" BorderThickness="1" Opacity="0"
                    IsHitTestVisible="False">
                <WrapPanel HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <Button Content="打开" Click="OpenFile_Click" Margin="0,0,8,0" ToolTip="打开文件 · Ctrl+O"/>
                        <Button x:Name="PlayPauseButton" Content="暂停" Click="PlayPause_Click" MinWidth="70"
                                Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Foreground="#191523" ToolTip="暂停 / 继续 · Space"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="速度" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SpeedSlider" Minimum="10" Maximum="150" Value="60" Width="120"
                                TickFrequency="10" VerticalAlignment="Center" ToolTip="调整速度 · ↑ / ↓" AutomationProperties.Name="速度"/>
                        <TextBlock x:Name="SpeedText" Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat={}{0:0} px/s}" Width="68" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,4">
                        <TextBlock Text="缩放" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="ZoomSlider" Minimum="50" Maximum="300" Value="100" Width="110"
                                TickFrequency="10" VerticalAlignment="Center" ValueChanged="ZoomSlider_ValueChanged" ToolTip="调整缩放 · + / −" AutomationProperties.Name="缩放"/>
                        <TextBlock x:Name="ZoomText" Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat={}{0:0}%}" Width="50" TextAlignment="Right" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="FullscreenButton" Content="退出全屏" Click="ExitFullscreen_Click" Margin="4" ToolTip="切换全屏 · F11"/>
                </WrapPanel>
            </Border>

            <TextBlock x:Name="PlayerTitle" VerticalAlignment="Top" HorizontalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False"
                       Margin="20" Padding="14,7" Foreground="#D1CDD9" Background="#E61C1D27"
                       FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="700"/>
        </Grid>

        <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#CC05070C">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="240" Height="4" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="#34333F" BorderThickness="0"/>
                <TextBlock x:Name="LoadingText" Text="正在读取文件…" FontSize="18"
                           HorizontalAlignment="Center" Margin="24,18,24,0" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="按 Esc 取消" FontSize="13" Foreground="#AAA7B8" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
